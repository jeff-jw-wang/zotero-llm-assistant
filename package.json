{
  "name": "zotero-llm-assistant",
  "type": "module",
  "version": "0.4.0",
  "description": "AI-powered research assistant for Zotero \u2014 chat with papers, search your library, and jump to cited pages.",
  "config": {
    "addonName": "Zotero LLM Assistant",
    "addonID": "zotero-llm-assistant@github.com",
    "addonRef": "zotero-llm-assistant",
    "addonInstance": "ZoteroLLMAssistant",
    "prefsPrefix": "extensions.zotero.zotero-llm-assistant"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jeff-jw-wang/zotero-llm-assistant.git"
  },
  "author": "Jeff Wang",
  "homepage": "https://github.com/jeff-jw-wang/zotero-llm-assistant",
  "license": "AGPL-3.0-or-later",
  "scripts": {
    "start": "zotero-plugin serve",
    "build": "zotero-plugin build && tsc --noEmit",
    "test:chunker": "tsx test/chunker.test.ts",
    "test:models": "tsx test/models.test.ts",
    "test:caching": "tsx test/caching.test.ts",
    "test:library-retrieval": "tsx test/library-retrieval.test.ts",
    "test:phase-c": "tsx test/phase-c.test.ts",
    "test:phase-d": "tsx test/phase-d.test.ts",
    "test:privacy": "tsx test/privacy-fallback.test.ts",
    "test:privacy-mismatch": "tsx test/privacy-mismatch.test.ts",
    "test:qa-fixes": "tsx test/qa-fixes.test.ts",
    "test:v0.1.1b": "tsx test/v0.1.1b.test.ts",
    "release": "zotero-plugin release",
    "test": "npm run -s test:chunker && npm run -s test:models && npm run -s test:caching && npm run -s test:library-retrieval && npm run -s test:phase-c && npm run -s test:phase-d && npm run -s test:privacy && npm run -s test:privacy-mismatch && npm run -s test:qa-fixes && npm run -s test:v0.1.1b"
  },
  "dependencies": {
    "@huggingface/transformers": "^3.8.1",
    "zotero-plugin-toolkit": "^5.1.4"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "zotero-plugin-scaffold": "^0.9.3",
    "zotero-types": "^4.1.3"
  }
}
